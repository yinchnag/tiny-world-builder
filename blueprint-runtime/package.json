{
  "name": "blueprint-runtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "lint": "eslint .",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:e2e": "playwright test",
    "types": "tsc -p core/tsconfig.json && tsc -p runtime/tsconfig.json && tsc -p editor/tsconfig.json && tsc -p tools/tsconfig.json && tsc -p integration/tsconfig.json",
    "check": "tsx tools/guard/check.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^3.0.0",
    "jsdom": "^25.0.0",
    "eslint": "^9.18.0",
    "eslint-plugin-boundaries": "^5.0.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsdoc": "^50.6.0",
    "globals": "^15.14.0",
    "jiti": "^2.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.0",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.0.0"
  }
}
